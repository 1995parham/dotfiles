<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>me.1995parham.wallpaper</string>
  <key>ProgramArguments</key>
  <array>
    <string>@ROOT@/wallpapers/rotate.sh</string>
    <string>@HOME@/Pictures/Barcelona</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/wallpaper.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/wallpaper.log</string>
</dict>
</plist>
