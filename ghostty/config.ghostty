#
#  ██████╗ ██╗  ██╗ ██████╗ ███████╗████████╗████████╗██╗   ██╗
# ██╔════╝ ██║  ██║██╔═══██╗██╔════╝╚══██╔══╝╚══██╔══╝╚██╗ ██╔╝
# ██║  ███╗███████║██║   ██║███████╗   ██║      ██║    ╚████╔╝
# ██║   ██║██╔══██║██║   ██║╚════██║   ██║      ██║     ╚██╔╝
# ╚██████╔╝██║  ██║╚██████╔╝███████║   ██║      ██║      ██║
#  ╚═════╝ ╚═╝  ╚═╝ ╚═════╝ ╚══════╝   ╚═╝      ╚═╝      ╚═╝
# A fast, native terminal emulator: https://ghostty.org/
# Written against Ghostty 1.4. What WezTerm did that Ghostty cannot is at the
# end of this file.
#
#   ghostty +validate-config        check this file
#   ghostty +explain-config <key>   documentation for one option
#   ghostty +show-config --default  every option with its default
#   ghostty +list-keybinds          the bindings in effect
#
# Reload a running Ghostty with cmd+shift+, or `kill -USR2 <pid>`.

# ===========================================================================
# Text
# ===========================================================================

# themes/naz, next to this file: the naz.vim palette, so vim and the CLI tools
# share one set of colours.
theme = naz

# Maple Mono NF: rounded, with ligatures and Nerd Font glyphs built in
# (./start.sh font installs it). The display runs at "More Space", which makes
# every font about 16% smaller, so 11pt here looks like 13pt.
font-family = Maple Mono NF
font-style = Medium
font-size = 11

# calt: ligatures on. cv04: an `l` with a foot, so it differs from `1` and `I`.
font-feature = calt, cv04=1

# 10% more space between lines. Long output and dense code are easier to
# follow when the lines do not touch.
adjust-cell-height = 10%

# Lift any text colour that is too close to its background to a 3:1 contrast
# (WCAG). naz's bright black (#575B61) is 1.9:1 on #323232, and it is the
# colour of comments, autosuggestions and dim text. The other colours are
# already above 3:1 and do not change.
minimum-contrast = 3

# No dark fringe around coloured text on a coloured background, with the same
# stroke weight as `native`.
alpha-blending = linear-corrected

# ===========================================================================
# Cursor and mouse
# ===========================================================================

cursor-style = block
cursor-style-blink = true

# Hide the pointer while typing; it comes back when the mouse moves.
mouse-hide-while-typing = true

# ===========================================================================
# Window
# ===========================================================================

# Tabs in the titlebar, next to the traffic lights. New windows only.
macos-titlebar-style = tabs

# Restore windows, tabs, splits and their directories after every quit.
window-save-state = always

# Close a tab or a window without a question.
confirm-close-surface = false

# Left Option is Alt (Meta) for the shell and tmux. Right Option still types
# special characters.
macos-option-as-alt = left

scrollback-limit-lines = 20000

# ===========================================================================
# Shell integration
# ===========================================================================

#   no-cursor     keep the block cursor at the prompt (not a bar)
#   ssh-env       set TERM=xterm-256color on remote hosts, forward COLORTERM
#   ssh-terminfo  install the xterm-ghostty terminfo on a host at first login
#   sudo          keep the terminfo visible under sudo
shell-integration-features = no-cursor,ssh-env,ssh-terminfo,sudo

# ===========================================================================
# Bell and notifications: "the long command is done"
# ===========================================================================

# Inside tmux: tmux rings the bell when a command of 30 s or more finishes
# (the pane-command-finished hook in tmux/tmux/tmux.conf). The bell then:
#   attention  bounces the dock icon once, if Ghostty is not focused
#   title      marks the tab title until the tab gets a key
#   border     draws a border around the terminal until it gets a key
bell-features = attention,title,border

# Without tmux (the quick terminal): Ghostty itself sends a desktop
# notification for a command of 30 s or more, if its terminal is not focused.
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

# ===========================================================================
# Quick terminal (cmd+s)
# ===========================================================================

# A terminal that slides up from the bottom of the screen and hides again. It
# is a separate window, not a split, and it keeps its session while hidden.
quick-terminal-position = bottom
quick-terminal-size = 30%
quick-terminal-screen = mouse

# ===========================================================================
# Keys
# ===========================================================================

# Previous and next tab: three pairs, for one hand, two hands and vim habits.
keybind = cmd+arrow_left=previous_tab
keybind = cmd+arrow_right=next_tab
keybind = ctrl+shift+arrow_left=previous_tab
keybind = ctrl+shift+arrow_right=next_tab
keybind = ctrl+shift+h=previous_tab
keybind = ctrl+shift+l=next_tab

keybind = cmd+s=toggle_quick_terminal
keybind = cmd+alt+i=inspector:toggle

# ===========================================================================
# Command palette (cmd+shift+p)
# ===========================================================================

# Snapp DC VPN: types `snapp-vpn <command>` (keys repo, bash/aliases/snapp.sh)
# into the focused terminal and runs it. Use at a shell prompt only: an editor
# gets plain keys. The tmux status line shows the state: 🚕 🟢 when
# gitlab.snapp.ir answers, 🚕 🟡 while ISE posture holds the tunnel.
command-palette-entry = title:"Snapp VPN: Connect",description:"Connect and wait for ISE posture.",action:"text:snapp-vpn connect\\r"
command-palette-entry = title:"Snapp VPN: Disconnect",description:"Close the tunnel.",action:"text:snapp-vpn disconnect\\r"
command-palette-entry = title:"Snapp VPN: Status",description:"Tunnel state and GitLab reachability.",action:"text:snapp-vpn status\\r"

# ===========================================================================
# Not in Ghostty
# ===========================================================================
#
# Ghostty has no scripting and no status bar. What WezTerm's right status
# showed is on the tmux status lines (tmux/tmux/status-bar.conf):
#   - the Jalali date and the world clocks   bin/bin/worldclock.sh
#   - the battery                            bin/bin/battery.sh
#   - the VPN badges, Snapp included         tmux/tmux/platform-macos.conf,
#                                            bin/bin/snapp-vpn-badge.sh
#
# No replacement:
#   - the navi split on cmd+n (cmd+n stays "new window")
#   - bidi: Ghostty draws right-to-left text in logical order, so Farsi reads
#     backwards. WezTerm's bidi_enabled has no counterpart.
#   - custom hyperlink and quick-select patterns (`link` cannot be set yet)
