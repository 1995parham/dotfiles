#
#  ██████╗ ██╗  ██╗ ██████╗ ███████╗████████╗████████╗██╗   ██╗
# ██╔════╝ ██║  ██║██╔═══██╗██╔════╝╚══██╔══╝╚══██╔══╝╚██╗ ██╔╝
# ██║  ███╗███████║██║   ██║███████╗   ██║      ██║    ╚████╔╝
# ██║   ██║██╔══██║██║   ██║╚════██║   ██║      ██║     ╚██╔╝
# ╚██████╔╝██║  ██║╚██████╔╝███████║   ██║      ██║      ██║
#  ╚═════╝ ╚═╝  ╚═╝ ╚═════╝ ╚══════╝   ╚═╝      ╚═╝      ╚═╝
# A fast, native terminal emulator
# https://ghostty.org/
#
# Ported from wezterm/wezterm.lua, written against Ghostty 1.4.
#
#   ghostty +validate-config        check this file
#   ghostty +explain-config <key>   documentation for one option
#   ghostty +show-config --default  every option with its default
#   ghostty +list-keybinds          the bindings in effect
#
# Ghostty has no scripting and no status bar, so WezTerm's right status (the
# Jalali date, the world clocks and the battery) moved to tmux's status lines:
# see tmux/tmux/status-bar.conf, bin/bin/worldclock.sh and bin/bin/battery.sh.
#
# Not portable from WezTerm:
#   - the navi split on cmd+n (cmd+n stays "new window")
#   - bidi: upstream Ghostty paints right-to-left text in logical order, so
#     Farsi reads backwards. WezTerm's bidi_enabled has no counterpart here.
#   - custom hyperlink and quick-select patterns (`link` cannot be set yet)

# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------

# themes/naz, next to this file: the naz.vim palette shared with WezTerm.
theme = naz

# ---------------------------------------------------------------------------
# Font
# ---------------------------------------------------------------------------

# Maple Mono NF: a warm, rounded face with ligatures and Nerd Font glyphs baked
# in (./start.sh font installs it). 10.5pt for eye comfort: the display runs at
# "More Space" (2056x1329), which shrinks every font by about 16%.
font-family = Maple Mono NF
font-style = Medium
font-size = 10.5

# cv04: alternate `l` with a left bottom bar (Consolas-style foot) so it is
# unmistakable next to `1`/`I`. calt keeps Maple Mono's ligatures on.
font-feature = calt, cv04=1

# ---------------------------------------------------------------------------
# Cursor
# ---------------------------------------------------------------------------

cursor-style = block
cursor-style-blink = true

# Hide the mouse pointer as soon as a key is typed, so it does not sit on top
# of the text. It comes back when the mouse moves.
mouse-hide-while-typing = true

# ---------------------------------------------------------------------------
# Shell integration
# ---------------------------------------------------------------------------

# no-cursor:    keep the block cursor at the prompt (integration would switch
#               it to a bar)
# ssh-env:      on remote hosts set TERM=xterm-256color and forward COLORTERM
# ssh-terminfo: install the xterm-ghostty terminfo entry on a host the first
#               time it is reached, so TERM=xterm-ghostty works there
# sudo:         keep the terminfo entry visible under sudo
shell-integration-features = no-cursor,ssh-env,ssh-terminfo,sudo

# ---------------------------------------------------------------------------
# Bell and notifications
# ---------------------------------------------------------------------------

# attention: bounce the dock icon once when Ghostty is not focused
# title:     put a bell on the tab title until the tab gets a key
# border:    draw a border around the terminal until it gets a key (stands in
#            for WezTerm's visual bell)
# tmux rings the bell of a pane when a command that took 30 seconds or more
# finishes (the pane-command-finished hook in tmux/tmux/tmux.conf), so these
# are what "the long command is done" looks like.
bell-features = attention,title,border

# The same for a shell that Ghostty runs itself, with no tmux in between (the
# quick terminal): a desktop notification when a command that took 30 seconds
# or more finishes while its terminal is not focused. It needs the shell
# integration, which is on by default. Since 1.3.
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

# ---------------------------------------------------------------------------
# Window
# ---------------------------------------------------------------------------

# Tabs folded into the titlebar next to the traffic lights, no separate title
# strip (WezTerm's INTEGRATED_BUTTONS). Applies to new windows only.
macos-titlebar-style = tabs

# Close a tab or window without asking (WezTerm's NeverPrompt).
confirm-close-surface = false

# Left Option is Alt (Meta) for the shell and tmux; right Option still composes
# characters. This is WezTerm's default behaviour on macOS.
macos-option-as-alt = left

# ---------------------------------------------------------------------------
# Scrollback
# ---------------------------------------------------------------------------

scrollback-limit-lines = 20000

# ---------------------------------------------------------------------------
# Quick terminal
# ---------------------------------------------------------------------------

# Stands in for WezTerm's cmd+s toggle pane: a terminal that slides up from the
# bottom of the screen and hides again. It is a separate window, not a split
# of the current tab, and it keeps its session while hidden.
quick-terminal-position = bottom
quick-terminal-size = 30%

# ---------------------------------------------------------------------------
# Keys
# ---------------------------------------------------------------------------

keybind = cmd+arrow_left=previous_tab
keybind = cmd+arrow_right=next_tab
keybind = ctrl+shift+arrow_left=previous_tab
keybind = ctrl+shift+arrow_right=next_tab
keybind = ctrl+shift+h=previous_tab
keybind = ctrl+shift+l=next_tab

keybind = cmd+alt+i=inspector:toggle
keybind = cmd+s=toggle_quick_terminal
